<?xml version="1.0" encoding="utf-8"?>
<!-- Tartan ground + lane texture. Corners follow the launcher via clipToOutline on the root view. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="#AD3B26" /><corners android:radius="28dp" /></shape></item>
    <item android:gravity="bottom|end" android:drawable="@drawable/daur_lanes" />
</layer-list>
