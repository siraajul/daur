<?xml version="1.0" encoding="utf-8"?>
<!-- Daur · Next meal, slim 4×1. The face is drawn by WidgetFace.kt (launchers ignore app fonts in widget layouts). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/daur_widget_bg" android:clipToOutline="true">
    <ImageView android:id="@+id/widget_face" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:contentDescription="@string/widget_track" />
    <!-- tap target over the drawn button -->
    <FrameLayout android:id="@+id/meal_btn" android:layout_width="72dp" android:layout_height="40dp"
        android:layout_gravity="center_vertical|end" android:layout_margin="16dp" android:contentDescription="Log this meal" />
</FrameLayout>
