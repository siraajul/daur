<?xml version="1.0" encoding="utf-8"?>
<!-- Daur · Next meal: the leg numeral, the 4-leg strip, the meal, Log (works in the background). -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/daur_widget_bg" android:clipToOutline="true" android:padding="16dp">
    <LinearLayout android:id="@+id/meal_numrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
        <TextView android:id="@+id/meal_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1/4" android:textColor="#FFD23F" android:textSize="46sp" android:fontFamily="@font/unbounded_black" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        <TextView android:id="@+id/meal_m" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="m" android:textColor="#FFD23F" android:textSize="16sp" android:fontFamily="@font/unbounded_black" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginStart="2dp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/meal_when_box" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:orientation="vertical" android:gravity="end">
        <TextView android:id="@+id/meal_lap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DAY 1" android:textColor="#FFD9CC" android:textSize="10sp" android:fontFamily="@font/unbounded_black" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:letterSpacing="0.06"/>
        <TextView android:id="@+id/meal_when" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFD9CC" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="3dp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/meal_legs" android:layout_below="@id/meal_numrow" android:layout_width="150dp" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal"><ImageView android:id="@+id/mleg1" android:layout_width="0dp" android:layout_height="7dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:src="@drawable/leg_todo" android:scaleType="fitXY" android:importantForAccessibility="no" /><ImageView android:id="@+id/mleg2" android:layout_width="0dp" android:layout_height="7dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:src="@drawable/leg_todo" android:scaleType="fitXY" android:importantForAccessibility="no" /><ImageView android:id="@+id/mleg3" android:layout_width="0dp" android:layout_height="7dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:src="@drawable/leg_todo" android:scaleType="fitXY" android:importantForAccessibility="no" /><ImageView android:id="@+id/mleg4" android:layout_width="0dp" android:layout_height="7dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:src="@drawable/leg_todo" android:scaleType="fitXY" android:importantForAccessibility="no" /></LinearLayout>
    <TextView android:id="@+id/meal_cap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFF8F3" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_below="@id/meal_numrow" android:layout_marginTop="6dp" android:visibility="gone"/>
    <TextView android:id="@+id/meal_btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Log" android:textColor="#3A1208" android:textSize="15sp" android:fontFamily="sans-serif-black" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_alignParentEnd="true" android:layout_alignParentBottom="true" android:background="@drawable/daur_pill" android:paddingHorizontal="18dp" android:paddingVertical="11dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:layout_toStartOf="@id/meal_btn" android:layout_marginEnd="12dp" android:orientation="vertical">
        <TextView android:id="@+id/meal_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Open Daur" android:textColor="#FFF8F3" android:textSize="20sp" android:fontFamily="@font/unbounded_black" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        <TextView android:id="@+id/meal_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFD9CC" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="3dp"/>
    </LinearLayout>
</RelativeLayout>
