<?xml version="1.0" encoding="utf-8"?>
<!-- Daur · Water: litres, 14 × 250 ml glasses, + glass (works in the background). -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/daur_widget_bg" android:clipToOutline="true" android:padding="14dp">
