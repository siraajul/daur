<?xml version="1.0" encoding="utf-8"?>
<!-- Daur · Today (medium): the track with metres, lap, next meal, kcal. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/daur_widget_bg" android:clipToOutline="true" android:orientation="horizontal" android:padding="14dp" android:gravity="center_vertical">
    <ImageView android:id="@+id/widget_track" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:scaleType="fitCenter" android:contentDescription="@string/widget_track" />
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:id="@+id/widget_lap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DAY 1 OF 84" android:textColor="#FFD9CC" android:textSize="10sp" android:fontFamily="@font/unbounded_black" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:letterSpacing="0.06"/>
        <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/widget_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Breakfast" android:textColor="#FFF8F3" android:textSize="18sp" android:fontFamily="@font/unbounded_black" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        <TextView android:id="@+id/widget_when" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="08:00–09:00" android:textColor="#FFF8F3" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="3dp"/>
        <ProgressBar android:id="@+id/widget_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp"
            android:layout_marginTop="10dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/daur_bar" />
        <TextView android:id="@+id/widget_kcal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 / 1,800 kcal" android:textColor="#FFD9CC" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="5dp"/>
    </LinearLayout>
</LinearLayout>
